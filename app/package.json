{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.33.3",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "vite dev --port 5199 --strictPort",
		"build": "vite build",
		"preview": "vite preview --strictPort",
		"start": "node scripts/start.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"study": "vite build && vite preview --port 8777 --strictPort"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.10",
		"jsdom": "^26.1.0",
		"svelte": "5.56.9",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "8.2.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@shopify/draggable": "^1.2.1",
		"dompurify": "3.4.14"
	},
	"pnpm": {
		"overrides": {
			"cookie": "^1.0.2"
		}
	}
}
