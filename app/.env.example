# Public origin of a deployed static build, including kit.paths.base, no trailing slash.
# Include the scheme: https://host (a bare hostname is treated as https).
# Leave unset for localhost / a raw folder — sharing tags stay relative.
# Must be present at `pnpm build` (Docker image build on Railway) so prerendered
# Open Graph / canonical tags are absolute. Current Railway host (will change):
# PUBLIC_SITE_URL=https://learning-korean-production.up.railway.app

# Build adapter. Omit for a static folder (`adapter-static`). The Dockerfile
# sets this to `node` so Railway serves with `@sveltejs/adapter-node`.
# ADAPTER=node

# Public origin the Node adapter should trust. Optional for this prerendered
# app (no server form actions). Set it to the same URL as PUBLIC_SITE_URL
# if you add server routes later.
# ORIGIN=https://learning-korean-production.up.railway.app

# Listen port for `pnpm start`. Railway injects PORT; local default is 3000.
# PORT=3000

# Reverse-proxy headers (already set in the Dockerfile for Railway).
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
